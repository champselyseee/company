# ── botback: переменные окружения ──
# Локально: скопируй в .env и заполни. На Railway задай в разделе Variables службы бота.

# Токен бота от @BotFather.
TELEGRAM_TOKEN=

# Общая база (та же, что у сайта). На Railway — ссылкой на Postgres.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Ключи ИИ (те же, что у сайта): проверка работ (Anthropic) и распознавание фото (xAI/Grok).
# Имена ДОЛЖНЫ совпадать с тем, что читает код core/: ANTHROPIC_API_KEY и XAI_API_KEY.
ANTHROPIC_API_KEY=
XAI_API_KEY=

# (необязательно) контакт поддержки для /help и ошибок оплаты.
SUPPORT_CONTACT=@champselyseee

# Магазин ЮKassa (shopId и секретный ключ) — /buy создаёт платёж, вебхук
# POST /yukassa/webhook перепроверяет его в API. Те же значения, что у сайта.
YUKASSA_SHOP_ID=
YUKASSA_SECRET=

# (необязательно) адрес сайта для текстов и кнопки «🌐 Сайт». По умолчанию https://expertege.valiullin.uk
SITE_URL=https://expertege.valiullin.uk

# (необязательно) напоминания «давно не проверял» / «подписка кончается». 0 — выключить.
REMINDERS_ENABLED=1

# ── Мини-аппа (Telegram WebApp) ──
# Адрес мини-аппы (botfront на Vercel), напр. https://botupdatedront.vercel.app — для кнопки WebApp.
WEBAPP_URL=

# Порт веб-сервера бота (обслуживает мини-аппу). На Railway задаётся автоматически.
PORT=8080

# Разрешённый источник (CORS) для мини-аппы; '*' допустимо (вход по initData, куки не шлём).
WEBAPP_ALLOWED_ORIGIN=*
